DATABASE_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Quién es administrador. Lista separada por comas; gana sobre DEFAULT_OWNER_EMAIL.
# Es una lista en el entorno y no una columna en la tabla a propósito: una fila
# que se le puede conceder a alguien es una fila que se concede por error.
ADMIN_EMAILS=
DEFAULT_OWNER_EMAIL=Santiago.labarca@berkeley.edu
DEFAULT_OWNER_NAME=Santiago Labarca

# Secreto compartido que el bot de Telegram manda como "Authorization: Bearer <secreto>".
# En el config.json del bot el mismo valor se llama task_api_secret.
#
# ⚠️ El bearer prueba que la petición viene del bot; NO dice de quién. Eso lo dice
# la cabecera X-Telegram-Chat-Id, y la API la resuelve a una fila de `users`. Un
# chat sin fila recibe 401: **no hay ningún fallback al dueño.** Lo hubo, y este
# archivo lo siguió documentando meses después de que se eliminara — quien lo
# leyera iba a reintroducir exactamente el defecto que el código advierte.
# Ver el comentario largo en src/lib/server/auth.ts.
OPENCLAW_API_SECRET=

# Notas de voz (Whisper). Sin esto el micrófono responde 503 "not_configured"
# y la interfaz dice qué falta en vez de "algo salió mal".
OPENAI_API_KEY=

# Invitaciones por correo. Sin dominio verificado en Resend, onboarding@resend.dev
# solo entrega al dueño de la cuenta — y desde que la puerta es solo por
# invitación, eso deja de ser un detalle: es el único camino de entrada.
RESEND_API_KEY=
INVITE_FROM=

# El bot al que apunta el QR y el enlace profundo de vinculación.
NEXT_PUBLIC_TELEGRAM_BOT=Melizion_bot

# Opcional, solo para la importación única desde Apps Script:
NEXT_PUBLIC_APPS_SCRIPT_URL=
