DATABASE_URL=
DEFAULT_OWNER_EMAIL=Santiago.labarca@berkeley.edu
DEFAULT_OWNER_NAME=Santiago Labarca
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Shared secret the Sydney Telegram bot sends as "Authorization: Bearer <secret>".
# The bot's own config.json calls this same value TASK_API_SECRET.
# Requests carrying it are served as DEFAULT_OWNER_EMAIL.
OPENCLAW_API_SECRET=

# Optional, only for one-time data import from Apps Script:
NEXT_PUBLIC_APPS_SCRIPT_URL=
