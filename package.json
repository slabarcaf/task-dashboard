{
  "name": "task-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate:from-sheet": "node scripts/migrate-from-apps-script.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit && next lint && node --test tests/*.test.mjs",
    "build:safe": "rm -rf .next && next build",
    "verify:sync": "node scripts/verify-sync.mjs"
  },
  "dependencies": {
    "google-auth-library": "^10.6.1",
    "next": "14.2.35",
    "pg": "^8.19.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.25",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.2"
  }
}
